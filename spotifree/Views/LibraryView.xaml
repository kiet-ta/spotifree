<UserControl x:Class="Spotifree.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,10,20,0">
            <RadioButton Content="Scanned Music"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         Margin="0,0,10,0"
                         IsChecked="{Binding IsScannedMusicSelected, Mode=TwoWay}" />
            <RadioButton Content="Playlists"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         IsChecked="{Binding IsPlaylistsSelected, Mode=TwoWay}" />
        </StackPanel>

        <!-- SCANNED MUSIC -->
        <Grid Grid.Row="1" Margin="10"
              Visibility="{Binding IsScannedMusicSelected, Converter={StaticResource BoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Scanned Music"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" />

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Add to playlist:"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Margin="0,0,5,0" />
                    <ComboBox Width="180"
                              ItemsSource="{Binding Playlists}"
                              SelectedItem="{Binding SelectedPlaylist}"
                              DisplayMemberPath="Name" />
                </StackPanel>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding ScannedTracks}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTracks}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                    <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*" />
                    <DataGridTextColumn Header="Duration (s)" Binding="{Binding Duration}" Width="Auto" />

                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Play"
                                            Margin="0,0,5,0"
                                            Command="{Binding DataContext.PlayTrackCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                    <Button Content="Add"
                                            Command="{Binding DataContext.AddTrackToPlaylistCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTracks}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <materialDesign:PackIcon Kind="MusicNoteOff"
                                         Width="100" Height="100"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource MaterialDesignBodyLight}"
                                         Margin="0,0,0,20" />

                <TextBlock Text="Chưa có nhạc bro ơi!"
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource MaterialDesignBody}" />

                <TextBlock Text="Vào Settings để scan thư mục nhạc nhé."
                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"
                           Foreground="Gray" />

                <Button Content="Đi tới Settings ngay"
                        Height="50"
                        Command="{Binding GoToSettingsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Center"
                        Padding="20,10" />
            </StackPanel>
        </Grid>

        <!-- PLAYLISTS -->
        <Grid Grid.Row="1" Margin="10"
              Visibility="{Binding IsPlaylistsSelected, Converter={StaticResource BoolToVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Playlists"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                <Button Content="Create Playlist"
                        Margin="10,0,0,0"
                        Command="{Binding CreatePlaylistCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Play Selected"
                        Margin="10,0,0,0"
                        Command="{Binding PlayPlaylistCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <ListBox ItemsSource="{Binding Playlists}"
                         SelectedItem="{Binding SelectedPlaylist}"
                         DisplayMemberPath="Name"
                         Margin="0,0,10,0" />

                <DataGrid Grid.Column="1"
                          ItemsSource="{Binding SelectedPlaylist.Tracks}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="*" />
                        <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="*" />
                        <DataGridTextColumn Header="Duration (s)" Binding="{Binding Duration}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
