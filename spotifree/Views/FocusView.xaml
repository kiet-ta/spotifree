<UserControl x:Class="Spotifree.Views.FocusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Spotifree.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FocusViewModel, IsDesignTimeCreatable=False}"
             Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsSessionRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Focus time..."
                       Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding CountdownText}"
                       Style="{StaticResource MaterialDesignHeadline1TextBlock}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,20"/>
            <Button Content="Cancel Session"
                    Command="{Binding CancelSessionCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="200"
                    Height="40"
                    Panel.ZIndex="999"
                    />
        </StackPanel>

        <Grid Visibility="{Binding IsSessionRunning, Converter={StaticResource InvertBooleanConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                <TextBlock Text="Focus Session Setup" 
                           Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Set timer, pick songs, and start your session." 
                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                           HorizontalAlignment="Center"
                           Foreground="Gray"
                           Margin="0,0,0,20"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="1. Set Time (minutes)" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    <TextBox Text="{Binding TimerMinutes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="e.g., 30"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,5,0,20"/>

                    <TextBlock Text="2. Find Tracks" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search your library..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,5,0,5"/>

                    <ListView ItemsSource="{Binding SearchResults}"
                              SelectedItem="{Binding SelectedSearchTrack, Mode=OneWayToSource}"
                              Height="300" Panel.ZIndex="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Song" DisplayMemberBinding="{Binding Title}" Width="200" />
                                <GridViewColumn Header="Artist" DisplayMemberBinding="{Binding Artist}" Width="150"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="3. Your Focus Playlist" Style="{StaticResource MaterialDesignHeadline6TextBlock}"/>
                    <Border BorderBrush="Gray" BorderThickness="1" Height="415" Margin="0,5,0,0">
                        <ListView ItemsSource="{Binding SelectedPlaylist}"
                                  SelectedItem="{Binding SelectedTrackToRemove, Mode=OneWayToSource}" SelectionChanged="ListView_SelectionChanged"
                                  Panel.ZIndex="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Song" DisplayMemberBinding="{Binding Title}" Width="200"/>
                                    <GridViewColumn Header="Artist" DisplayMemberBinding="{Binding Artist}" Width="150"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </Grid>

            <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Content="Start Focus Session"
                    Command="{Binding StartSessionCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Center"
                    Height="50"
                    Padding="30,10"
                    Margin="0,20,0,0"/>
        </Grid>
    </Grid>
</UserControl>